{
  "name": "mirofish-arena",
  "version": "0.0.1",
  "private": true,
  "description": "Live AI agent reasoning arena on Stellar testnet, powered by MiroFish simulated reality.",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "contract:build": "cd contracts/live-round && stellar contract build",
    "contract:test": "cd contracts/live-round && cargo test",
    "contract:deploy": "node scripts/deploy-contract.mjs"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.4",
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
