# Stellar testnet
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployed addresses (filled in after deploy)
LIVE_ROUND_CONTRACT_ID=
REPUTATION_TOKEN_ID=

# Oracle service
ORACLE_SIGNING_SECRET=
ORACLE_STELLAR_SECRET=
ORACLE_PORT=4000

# Runner service
RUNNER_PORT=4001
RUNNER_DB_PATH=./data/runner.db

# Web app
NEXT_PUBLIC_ORACLE_URL=http://localhost:4000
NEXT_PUBLIC_RUNNER_URL=http://localhost:4001
NEXT_PUBLIC_LIVE_ROUND_CONTRACT_ID=

# LLM providers (only need one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# MiroFish (oracle vendors the upstream repo; LLM endpoint it uses)
MIROFISH_MODEL=gpt-4o-mini
MIROFISH_PERSONA_COUNT=40
MIROFISH_TICKS=12

# Dev mode: shortens round cycle from 5 min → 2 min for local iteration.
DEV_MODE=0
